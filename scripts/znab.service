# znab in production: one supervised process, the API serving the built web
# app itself, on port 3001 against the `znab` database. Caddy fronts it as
# http://znab (scripts/Caddyfile proxies to 127.0.0.1:3001 only).
#
# Supervised rather than nohup'd, so it comes back after a crash and after a
# reboot, and its output goes to journald instead of a shell that closes.
#
# It is a user service rather than a system one: znab runs as one person on one
# machine (host `znab`) and needs nothing root owns.
#
# Install:
#
#   mkdir -p ~/.config/systemd/user
#   cp scripts/znab.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#
#   # Build the web app first, or the service refuses to start and says so.
#   bun run build
#
#   systemctl --user enable --now znab
#
#   # Without this it stops when you log out and does not come back on reboot.
#   sudo loginctl enable-linger zach
#
#   systemctl --user status znab
#   journalctl --user -u znab -f
#
# Deploys: `bun run deploy` (scripts/deploy.sh) backs up, pulls main, builds,
# migrates and restarts this service.
#
# Developing needs no stop: `bun run dev` runs Vite on 5173 and the dev API on
# 3002 against the separate `znab_dev` database (scripts/dev-env.sh), beside
# this service. `bun run db:refresh-dev` reloads znab_dev from prod data.

[Unit]
Description=znab
Documentation=https://github.com/SirZach/znab
# Postgres lives in docker, which is a system service, so this is a hint rather
# than a guarantee: the Restart below is what actually covers starting early.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/znab
# NODE_ENV=production stops Bun loading any .env.development, and variables set
# here win over any .env file Bun finds in the working directory, so no dev
# setting can leak in. apps/api/.env holds DATABASE_URL (database `znab`) and
# API_PORT (3001, or unset for the same default), the port Caddy and
# deploy.sh's health check expect. Dev overrides both in scripts/dev-env.sh.
Environment=NODE_ENV=production
Environment=SERVE_WEB=1
EnvironmentFile=%h/workspace/znab/apps/api/.env
ExecStart=%h/.bun/bin/bun apps/api/src/index.ts

# Postgres may not be accepting connections yet on a cold boot, and the app
# exits rather than waiting, so coming straight back is the whole recovery.
Restart=always
RestartSec=3

# 6GB and 2 vCPUs on this machine, shared with Postgres and the dev servers,
# and the app sits around 40MB. A cap this far above that is not a budget, it
# is a tripwire: reaching it means something is wrong and being restarted beats
# taking the machine into swap.
MemoryMax=512M

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
