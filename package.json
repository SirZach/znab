{
  "name": "znab",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "web:restart": "bash scripts/restart-web.sh",
    "build": "bun run --filter web build",
    "start": "SERVE_WEB=1 bun run --filter api start",
    "db:generate": "bun run --filter @znab/db generate",
    "db:migrate": "bun run --filter @znab/db migrate",
    "db:studio": "bun run --filter @znab/db studio",
    "import": "bun run --filter api import",
    "ynab:reset": "FORCE=1 bash scripts/sync-ynab4.sh",
    "test": "bun run --filter '*' test",
    "test:db": "bun run --filter api test:db",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/web && tsc --noEmit -p packages/db && tsc --noEmit -p packages/shared",
    "lint": "biome lint .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^7.0.2"
  }
}
