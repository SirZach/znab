# Copy to ~/.config/znab/backup.env and chmod 600. Read by znab-backup.service
# and znab-restore-check.service. Every line is optional; placeholders only.

# Uptime Kuma push monitors. The token in each URL is a secret.
ZNAB_BACKUP_PUSH_URL=http://docker:3001/api/push/REPLACE_ME
ZNAB_RESTORE_PUSH_URL=http://docker:3001/api/push/REPLACE_ME

# rclone destination for the daily dumps. Set it empty to skip offsite.
#ZNAB_BACKUP_REMOTE=dropbox:znab-backups

# Local dump folder.
#ZNAB_BACKUP_DIR=/home/zach/.local/share/znab/backups

# Retention.
#ZNAB_KEEP_DAILY=14
#ZNAB_KEEP_WEEKLY=8
#ZNAB_KEEP_MONTHLY=12
#ZNAB_KEEP_PREDEPLOY=10

# Restore check.
#ZNAB_RESTORE_TOLERANCE_ROWS=50
#ZNAB_RESTORE_TOLERANCE_PCT=1
#ZNAB_RESTORE_MAX_AGE_HOURS=48
